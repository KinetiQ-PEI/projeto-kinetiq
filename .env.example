# Copiar para .env e alterar se necessário (o compose usa estes valores por omissão)
POSTGRES_DB=kinetiq
POSTGRES_USER=kinetiq
POSTGRES_PASSWORD=kinetiq

INFLUXDB_USER=kinetiq
INFLUXDB_PASSWORD=kinetiq123
INFLUXDB_ORG=kinetiq
INFLUXDB_BUCKET=telemetry
INFLUXDB_TOKEN=kinetiq-dev-token

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# IPs/nomes extra no certificado TLS do Mosquitto (8883), ex.: IP:192.168.1.50
# Depois de alterar: docker compose up -d && docker compose restart mosquitto
MQTT_TLS_EXTRA_SAN=

# Simulador IoT (perfil simulation): docker compose up -d --build simulator
# O serviço liga-se a mosquitto:1883 dentro da rede Docker.
SIM_BIKE_COUNT=5
SIM_INTERVAL_SECONDS=2
MQTT_TIMEOUT_SECONDS=10
# Opcionais: manter comentadas para usar os valores por omissão do script.
# SIM_BIKE_YEAR=2026
# SIM_SEED=36
# MQTT_TOPIC_TEMPLATE=kinetiq/bikes/{bike_id}/telemetry
# MQTT_USERNAME=
# MQTT_PASSWORD=
