{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FleetAlertEvent",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string" },
    "alertId": { "type": "string", "format": "uuid" },
    "bikeId": { "type": "string", "pattern": "^MB-\\d{4}-\\d{3}$" },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix timestamp in milliseconds."
    },
    "alertType": {
      "type": "string",
      "enum": ["LOW_BATTERY", "UNAUTHORIZED_ZONE", "MAINTENANCE_REQUIRED", "CONNECTION_LOST", "ML_ANOMALY"],
      "description": "ML_ANOMALY: anomaly detected by the ML module (RF12)."
    },
    "severity": {
      "type": "string",
      "enum": ["INFO", "WARNING", "CRITICAL"]
    },
    "zoneId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "description": "Code of the zone where the bike is (e.g. LIBRARY_HUB), as in the zones table. Optional for every alert type; required for UNAUTHORIZED_ZONE."
    },
    "details": {
      "type": "string",
      "description": "Short description of the alert, shown as the row title in the dashboard (e.g. 'Low battery (12%)')."
    }
  },
  "required": ["schemaVersion", "alertId", "bikeId", "timestamp", "alertType", "severity"],
  "if": { "properties": { "alertType": { "const": "UNAUTHORIZED_ZONE" } } },
  "then": { "required": ["zoneId"] },
  "additionalProperties": false
}