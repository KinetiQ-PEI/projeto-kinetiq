{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BikeStateChangedEvent",
  "description": "Publicado no tópico Kafka fleet.events.status sempre que uma bicicleta muda de estado. Chave da mensagem: bikeId.",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "description": "Versão do schema, ex.: 1.0." },
    "eventId": { "type": "string", "format": "uuid", "description": "Identificador único do evento (idempotência)." },
    "bikeId": { "type": "string", "pattern": "^MB-\\d{4}-\\d{3}$" },
    "timestamp": { "type": "integer", "minimum": 0, "description": "Unix timestamp em milissegundos da mudança de estado." },
    "previousState": { "type": "string", "enum": ["AVAILABLE", "IN_USE", "IN_MAINTENANCE", "RETIRED"] },
    "newState": { "type": "string", "enum": ["AVAILABLE", "IN_USE", "IN_MAINTENANCE", "RETIRED"] },
    "trigger": { "type": "string", "enum": ["START_TRIP", "END_TRIP", "SEND_TO_MAINTENANCE", "COMPLETE_REPAIR", "RETIRE"] },
    "actorRole": { "type": "string", "enum": ["RIDER", "FLEET_OPERATOR", "MAINTENANCE_TECHNICIAN", "SYSTEM"] },
    "actorId": { "type": ["string", "null"], "maxLength": 64 },
    "reason": { "type": ["string", "null"], "maxLength": 500 }
  },
  "required": ["schemaVersion", "eventId", "bikeId", "timestamp", "previousState", "newState", "trigger", "actorRole"],
  "additionalProperties": false
}
