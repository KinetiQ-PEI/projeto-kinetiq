{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BikeTelemetryEvent",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único do evento de telemetria."
    },
    "bikeId": {
      "type": "string",
      "description": "Identificador único da bicicleta (ex: MB-2026-042)."
    },
    "timestamp": {
      "type": "integer",
      "description": "Timestamp Unix em milímetros da recolha do dado."
    },
    "location": {
      "type": "object",
      "properties": {
        "latitude": { "type": "number" },
        "longitude": { "type": "number" }
      },
      "required": ["latitude", "longitude"]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "speed": { "type": "number", "description": "Velocidade atual em km/h." },
        "batteryLevel": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Percentagem de bateria restante." },
        "odometer": { "type": "number", "description": "Quilometragem total acumulada." }
      },
      "required": ["speed", "batteryLevel"]
    },
    "status": {
      "type": "string",
      "enum": ["AVAILABLE", "IN_USE", "MAINTENANCE", "INACTIVE"],
      "description": "Estado operacional atual da bicicleta."
    }
  },
  "required": ["eventId", "bikeId", "timestamp", "location", "metrics", "status"]
}